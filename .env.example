# Profil : development, test ou production
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs

# Emplacements, relatifs à la racine du projet ou absolus
REPORT_PATH=data/Rapport annuel 2025-BCM.pdf
INDEX_PATH=storage/bcm_index.joblib

# Fournisseur de génération : auto, openai, gemini, ollama ou extractive
GENERATION_PROVIDER=auto

# OpenAI (facultatif). Ne jamais mettre la clé dans le code source.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_RERANK_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=3000

# Gemini (facultatif). Bascule temporaire utile en cas de quota OpenAI épuisé :
# GENERATION_PROVIDER=gemini. La reformulation et le reranking avancés restent
# réservés à openai ; gemini répond directement sur la première recherche.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=8000
GEMINI_THINKING_LEVEL=low

# Analyse des graphiques : rendu et OCR entièrement locaux. Seul le texte OCR
# pertinent rejoint ensuite le contexte RAG ; les images restent sur la machine.
CHART_ANALYSIS_ENABLED=true
CHART_CACHE_PATH=storage/chart_pages
CHART_RENDER_DPI=170
CHART_MAX_PAGES=2
CHART_OCR_MAX_CHARS=5000
CHART_OCR_PATH=storage/chart_ocr
# Facultatif : chemin absolu de pdftoppm si l'outil n'est pas dans le PATH.
# Chemin vers pdftoppm (Poppler), qui rend une page PDF en image. Utilisé par
# l'analyse de graphiques et par l'extraction OCR des Lettres d'information.
# Laisser vide : l'outil est cherché dans le PATH, puis aux emplacements usuels
# de Homebrew et MacPorts. Ne renseigner que si Poppler est installé ailleurs.
PDF_RENDERER_PATH=

# Recherche sémantique hybride exécutée localement : le rapport ne quitte pas la machine.
SEMANTIC_RETRIEVAL=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_PATH=storage/models
SEMANTIC_WEIGHT=0.45
MIN_SEMANTIC_SCORE=0.88
EMBEDDING_BATCH_SIZE=64

# Ollama local (facultatif)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Réseau local
API_HOST=127.0.0.1
API_PORT=5000
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7861
WIDGET_HOST=127.0.0.1
WIDGET_PORT=8090
API_URL=http://127.0.0.1:5000
OPEN_BROWSER=true

# Récupération
TOP_K=5
RETRIEVAL_CANDIDATES=18
MIN_RELEVANCE_SCORE=0.075

# Limites de sécurité de l'API
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=16
MAX_REQUEST_BYTES=65536

# Administration : obligatoire pour POST /api/reindex en production
REINDEX_TOKEN=

# Sécurité de l'API publique
# Origines autorisées en cross-origin pour /api/*, séparées par des virgules.
# Vide = aucun en-tête CORS émis (aucun appel navigateur cross-origin possible).
CORS_ALLOWED_ORIGINS=
# Limite d'appels par client sur POST /api/ask (syntaxe flask-limiter).
RATE_LIMIT_ASK=20 per minute

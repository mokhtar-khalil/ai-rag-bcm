# Modèle de configuration de PRODUCTION. Copiez ce fichier en .env.production
# (jamais committé, voir .gitignore) et complétez les valeurs réelles avant
# tout déploiement sur bcm.mr. Ne jamais mettre de secret dans le code source
# ou dans une image Docker.

APP_ENV=production
LOG_LEVEL=INFO

# Emplacements par défaut adaptés à l'image Docker (répertoire /app) ; à
# ajuster uniquement pour un déploiement hors conteneur.
REPORT_PATH=data/Rapport annuel 2025-BCM.pdf
INDEX_PATH=storage/bcm_index.joblib

# Fournisseur de génération réel en production.
GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_RERANK_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=3000

# Gemini : bascule temporaire (GENERATION_PROVIDER=gemini) en cas de quota
# OpenAI épuisé, en attendant sa réinitialisation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=8000
GEMINI_THINKING_LEVEL=low

# L'OCR local des graphiques (Swift + Apple Vision) est indisponible dans
# l'image Linux : ne pas activer tant qu'un moteur OCR multiplateforme ne l'a
# pas remplacé (voir Dockerfile et roadmap d'industrialisation).
CHART_ANALYSIS_ENABLED=false

SEMANTIC_RETRIEVAL=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_PATH=storage/models
SEMANTIC_WEIGHT=0.45
MIN_SEMANTIC_SCORE=0.88
EMBEDDING_BATCH_SIZE=64

# Réseau : 0.0.0.0 est nécessaire pour être joignable depuis l'extérieur du
# conteneur. Ne jamais exposer directement ce port sur Internet : placez un
# reverse proxy TLS (Nginx, load balancer BCM) devant l'API.
API_HOST=0.0.0.0
API_PORT=5000
OPEN_BROWSER=false

# Dimensionnement Gunicorn (voir run_api_prod.sh). À ajuster après un test de
# charge réel (roadmap, Phase 4) — les valeurs par défaut sont volontairement
# prudentes.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=210

# Récupération
TOP_K=5
RETRIEVAL_CANDIDATES=18
MIN_RELEVANCE_SCORE=0.075

# Limites de sécurité de l'API
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=16
MAX_REQUEST_BYTES=65536

# Administration : jeton obligatoire pour POST /api/reindex en production.
# Générer une valeur aléatoire longue, par exemple : openssl rand -hex 32
REINDEX_TOKEN=

# Sécurité de l'API publique : uniquement le(s) domaine(s) réel(s) du site
# BCM qui hébergera le widget. Jamais de wildcard "*" en production.
CORS_ALLOWED_ORIGINS=https://bcm.mr
RATE_LIMIT_ASK=20 per minute
WIDGET_HOST=127.0.0.1
WIDGET_PORT=8090

# Anti-abus par session : nombre de questions autorisées avant que la session
# ne se réinitialise (compteur remis à zéro après ce délai d'inactivité).
SESSION_MAX_QUESTIONS=10
SESSION_IDLE_MINUTES=30

# Journalisation des questions consenties, à des fins d'analyse. Une URL
# Postgres (ex. extension Railway) active la persistance ; vide, un fichier
# SQLite local sert de repli, non durable sur Railway sans volume attaché.
DATABASE_URL=

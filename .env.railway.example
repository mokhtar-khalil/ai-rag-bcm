# Variables à définir dans le tableau de bord Railway (Variables → Raw Editor).
# Ne pas commiter de valeurs réelles : ce fichier est un modèle.
#
# PORT n'y figure pas volontairement : Railway l'injecte, et la configuration
# lui donne la priorité sur API_PORT.

APP_ENV=production
API_HOST=0.0.0.0

GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_RERANK_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=3000

# Origines autorisées à appeler l'API depuis un navigateur. « bcm.mr » et
# « www.bcm.mr » sont deux origines distinctes : citer les deux si le site
# répond sur les deux.
CORS_ALLOWED_ORIGINS=https://www.bcm.mr,https://bcm.mr,https://assistant-bcm.vercel.app

RATE_LIMIT_ASK=20 per minute
REINDEX_TOKEN=

# Un processus ayant chargé le modèle d'embedding occupe environ 811 Mo, et
# chaque worker charge sa propre copie. Augmenter cette valeur multiplie la
# mémoire sans gagner en débit, et fausserait le compteur de limitation qui vit
# en mémoire du processus.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=210

# L'OCR des graphiques exige Swift et Apple Vision : indisponibles sur Linux.
CHART_ANALYSIS_ENABLED=false

SEMANTIC_RETRIEVAL=true
TOP_K=5
RETRIEVAL_CANDIDATES=18
